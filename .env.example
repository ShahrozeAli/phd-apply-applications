APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./data/phd_bot.db
# DATABASE_URL=postgresql+psycopg://phd:phd@localhost:5432/phd_bot

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DISCOVERY_USER_AGENT=PhDApplyBot/0.1 (personal academic search; local instance)
DISCOVERY_MAX_PAGES=3
DISCOVERY_MAX_DETAIL_PAGES=25
DISCOVERY_REQUEST_DELAY_SECONDS=1.2

# Optional LLM for extraction/document drafting. Leave empty to use rules only.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM=
NOTIFY_TO=

DAILY_DISCOVERY_HOUR=6
DAILY_DISCOVERY_MINUTE=0
